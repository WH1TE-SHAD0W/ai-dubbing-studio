# Editor settings shared by everyone; most editors read this file automatically.
# See https://editorconfig.org
root = true

[*]
charset = utf-8
# Every file ends with exactly one newline (markdownlint MD047 and MD012).
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown, so keep them.
trim_trailing_whitespace = false
