# Rendered at container start by the official nginx image (envsubst on defined env vars).
# $-variables that are not environment variables (e.g. $uri) are left alone.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's embedded DNS. Lets nginx start (and keep running) while the backend is down.
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

  gzip on;
  gzip_min_length 512;
  gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

  # `expires` is used for caching below on purpose: unlike add_header it doesn't stop these server-level headers being inherited.
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Backend API (HTTP, SSE and WebSocket): strip the /api prefix and forward. The variable defers DNS lookup to request time.
  # API_UPSTREAM must be an origin with no path, e.g. http://backend:8000
  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_buffering off;        # Server-Sent Events (live stats)
    proxy_read_timeout 1h;
    client_max_body_size 1m;    # JSON only; audio travels over the WebSocket
  }

  # Files that must always be revalidated so deploys and service-worker updates are picked up.
  location = /index.html { expires -1; }
  location = /sw.js { expires -1; }
  location = /registerSW.js { expires -1; }
  location = /manifest.webmanifest {
    default_type application/manifest+json;  # not in the stock mime.types
    expires -1;
  }

  # Content-hashed build output.
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve the shell and React Router takes over.
  location / {
    try_files $uri /index.html;
  }
}
