# Go tooling (gofmt, the generated-code drift check) expects LF line endings,
# also on Windows checkouts with core.autocrlf=true.
*.go           text eol=lf
go.mod         text eol=lf
go.sum         text eol=lf
Dockerfile     text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.wav          binary
