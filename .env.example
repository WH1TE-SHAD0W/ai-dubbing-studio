# Copy to .env and edit. .env is git-ignored.

# Google AI Studio key with access to the Gemini Live Translate preview model.
# Stays on the server; the browser never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-live-translate-preview

# The one host account (hardcoded stand-in for real auth; checked by the backend).
HOST_EMAIL=host@example.com
HOST_PASSWORD=change-me
HOST_NAME=Host

# Optional. Signs the login cookie; leave empty to generate one at boot.
SESSION_SECRET=

# Spend guards (each target language is its own paid Gemini stream).
MAX_SESSION_MINUTES=240
HOST_GRACE_SECONDS=60
MAX_TARGET_LANGUAGES=5

# info (default) or debug. debug adds per-message Gemini traces and a session report every 5 s.
LOG_LEVEL=info

# Where the frontend's nginx forwards /api. Origin only, no path.
API_UPSTREAM=http://backend:8000

# Port the app is served on.
PORT=8080
