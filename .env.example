# Copy to .env (which Git ignores) and change the password and the secret.
POSTGRES_USER=dubbing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dubbing

# Used by the Hono API when it runs outside Docker (`pnpm --filter @ads/api dev`).
# Inside Docker Compose the API builds its own URL from the three values above,
# so keep the password free of characters that need URL-encoding (@ : / ? #).
DATABASE_URL=postgres://dubbing:change-me@localhost:5432/dubbing

# Signs Better Auth's login cookies. At least 32 random characters, e.g. from
# `openssl rand -base64 32`. Changing it logs every host out.
BETTER_AUTH_SECRET=

# The address the browser uses to open the app. https makes the cookie Secure.
BETTER_AUTH_URL=http://localhost:3000

# Other origins allowed to log in, comma-separated. The Vite dev server
# (`pnpm dev`, port 5173) needs to be listed here.
TRUSTED_ORIGINS=http://localhost:5173

# Reverse proxies in front of the API, comma-separated IPs or CIDR ranges.
# Leave empty when the browser connects to the API directly.
TRUSTED_PROXIES=

# Port the API and the app are published on (Docker Compose).
API_PORT=3000

# Translation jobs (ADR-0018). The API on your machine reaches Redis here;
# inside Docker Compose the API and the workers use redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Shared by the API and the translator workers for the /internal calls.
# At least 32 random characters, e.g. from `openssl rand -hex 32`.
INTERNAL_API_TOKEN=

# Gemini Live Translate, used by the translator workers (one paid stream per
# target language).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-live-translate-preview

# Optional: how many idle workers to keep (Compose `translator` profile), and
# where the workers find the API (default: the api service in Compose; use
# http://host.docker.internal:3000 when the API runs on your machine).
# TRANSLATOR_REPLICAS=2
# TRANSLATOR_CONTROL_API_URL=http://host.docker.internal:3000
