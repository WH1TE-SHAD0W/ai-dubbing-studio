# Copy to .env (which Git ignores) and change the password.
POSTGRES_USER=dubbing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dubbing

# Used by the Hono API (YGP-65) to connect.
DATABASE_URL=postgres://dubbing:change-me@localhost:5432/dubbing

# LiveKit (YGP-68). The server and the Hono API both read these. Make your own
# key and a secret of at least 32 random characters, e.g. with
# `openssl rand -base64 32`. Never use LiveKit's --dev keys outside local work.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters
# Optional, for testing from a phone on the same Wi-Fi (YGP-72):
# LIVEKIT_BIND=0.0.0.0
# LIVEKIT_NODE_IP=192.168.1.20
