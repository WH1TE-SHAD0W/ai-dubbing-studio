{
  "name": "ai-dubbing-studio",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ads/web dev",
    "dev:mock": "pnpm --filter @ads/web dev:mock",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/**",
    "coverage:summary": "node scripts/coverage-summary.mjs"
  }
}
